# -----------------------------------------------------------------------------
# PriceHook environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# -----------------------------------------------------------------------------

# PostgreSQL connection string
# - App runtime: prefer Neon pooled URL
# - Local/dev: any Postgres URL works
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Direct (unpooled) Neon connection — useful for migrations if the pooler fails
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Protects POST/GET /api/cron/check-prices
# Generate something long and random, e.g.: openssl rand -hex 32
CRON_SECRET="change-me-to-a-long-random-secret"

# Optional metadata written by `neon deploy` (safe to leave empty locally)
NEON_BRANCH="production"
NEON_BRANCH_ID=""
NEON_FUNCTION_HOST_SUFFIX=""
